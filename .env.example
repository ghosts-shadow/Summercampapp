# ==========================================================================
#  ST. JOSEPH'S CATHEDRAL SUMMER CAMP — Environment Variables
#  Copy this file to `.env` and fill in real values.
# ==========================================================================

# --------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# --------------------------------------------------------------------------
# Local example:
#   postgresql://postgres:postgres@localhost:5432/summercamp?schema=public
#
# Vercel Postgres / Neon / Supabase provide a pooled connection string.
# Use the POOLED url for DATABASE_URL (runtime) and the DIRECT/non-pooled
# url for DIRECT_URL (migrations). If your provider has no separate direct
# url, set DIRECT_URL to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/summercamp?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/summercamp?schema=public"

# --------------------------------------------------------------------------
# AUTH (NextAuth / Auth.js v5)
# --------------------------------------------------------------------------
# Generate a strong secret with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# Canonical site URL. On Vercel this is set automatically, but set it
# explicitly for custom domains. Used for callbacks and absolute links.
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --------------------------------------------------------------------------
# SEED ADMIN ACCOUNT (used by `npm run db:seed`)
# --------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@stjosephscamp.org"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Camp Administrator"

# --------------------------------------------------------------------------
# APP CONFIG
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="St. Joseph's Cathedral Summer Camp"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
